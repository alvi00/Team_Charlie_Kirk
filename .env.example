# --- primary provider: OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-4.1-mini

# --- optional cross-provider failover (leave the key empty to disable) ---
FALLBACK_PROVIDER_API_KEY=
FALLBACK_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_PROVIDER_MODEL=openai/gpt-oss-120b

# --- call behaviour ---
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=2
LLM_TOTAL_BUDGET_SECONDS=12
LLM_REASONING_EFFORT=low

# --- service ---
PORT=8000
LOG_LEVEL=INFO
